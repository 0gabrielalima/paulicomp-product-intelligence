# Porta da API
PORT=3100

# Banco de dados. Sem DATABASE_URL o sistema usa um Postgres embutido (PGlite) em data/pgdata.
# Em producao use um Postgres real (Supabase, Render, Neon...):
# DATABASE_URL=postgres://usuario:senha@host:5432/banco

# Primeiro administrador (criado so se nao existir nenhum usuario)
ADMIN_EMAIL=admin@paulicomp.local
ADMIN_PASSWORD=troque-esta-senha
ADMIN_NAME=Administrador

# Worker de pesquisas no mesmo processo da API (obrigatorio com PGlite)
WORKER_INLINE=true

# ---- Integracoes (deixe vazio enquanto nao contratadas; o sistema mostra "nao configurado") ----
# IA + pesquisa web (Anthropic)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
# Mercado Livre (app criado na conta de vendedor)
MELI_CLIENT_ID=
MELI_CLIENT_SECRET=
MELI_REFRESH_TOKEN=
# eBay Browse API
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
